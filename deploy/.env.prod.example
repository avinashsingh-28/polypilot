# Copy to deploy/.env.prod (gitignored) and fill in. Placeholders only — never commit real values.
ENVIRONMENT=production
POSTGRES_DB=polypilot
POSTGRES_USER=polypilot
POSTGRES_PASSWORD=CHANGE_ME_long_random
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=CHANGE_ME
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CORS_ORIGINS=["https://polypilot.example.com"]
REGISTRATION_OPEN=false
METRICS_TOKEN=CHANGE_ME
LOG_JSON=true

AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash
# Optional server key for a non-Gemini AI_PROVIDER (anthropic, openai, groq, ...)
AI_API_KEY=
# Encrypts the API keys users save on the AI Providers page (falls back to POLYGON_CREDENTIALS_KEY).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CREDENTIALS_KEY=CHANGE_ME
AI_MAX_CALLS_PER_USER_PER_DAY=200

# Polygon: per-user credentials are saved encrypted from the UI (needs this Fernet key).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
POLYGON_CREDENTIALS_KEY=CHANGE_ME
POLYGON_API_KEY=
POLYGON_API_SECRET=
POLYGON_ENV_CREDENTIALS_EMAIL=

SANDBOX_IMAGE=polypilot-sandbox:latest
SANDBOX_MAX_CONCURRENT=2
# SANDBOX_RUNTIME=runsc   # after installing gVisor on the host (recommended for public use)

DOCKER_GID=999
WEB_BIND=127.0.0.1

# Forgot password (required for password resets in production)
PUBLIC_APP_URL=https://polypilot.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Sign in with Google (optional). Create an OAuth client (Web application) in Google Cloud Console
# with Authorized redirect URI = {PUBLIC_APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
