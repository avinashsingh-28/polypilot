# Database Configuration (PostgreSQL with psycopg 3 driver)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polypilot
POSTGRES_USER=polypilot_user
POSTGRES_PASSWORD=polypilot

# AI Provider Configuration
AI_PROVIDER=gemini
# Get your free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=CHANGE_ME
AI_MODEL=gemini-1.5-flash
# DATABASE_URL=postgresql+psycopg://polypilot_user:CHANGE_ME_PASSWORD@localhost:5432/polypilot

# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
