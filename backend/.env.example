# Database Configuration (PostgreSQL with psycopg 3 driver)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polypilot
POSTGRES_USER=polypilot_user
POSTGRES_PASSWORD=CHANGE_ME

# AI Provider Configuration
AI_PROVIDER=gemini
# Get your free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=CHANGE_ME
AI_MODEL=gemini-3.5-flash
# DATABASE_URL=postgresql+psycopg://polypilot_user:CHANGE_ME_PASSWORD@localhost:5432/polypilot

# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ── Phase 4: sandbox & verification limits (server-side maxima) ──
# SANDBOX_DOCKER_MODE=auto            # auto | native | wsl
# SANDBOX_WSL_DISTRO=Ubuntu-22.04
# SANDBOX_IMAGE=polypilot-sandbox:latest
# SANDBOX_MAX_CONCURRENT=2
# SANDBOX_PIDS_LIMIT=64
# COMPILE_TIMEOUT_SEC=30
# DEFAULT_TIME_LIMIT_SEC=2
# MAX_TIME_LIMIT_SEC=10
# MAX_MEMORY_MB=1024
# MAX_OUTPUT_BYTES=16777216
# MAX_INPUT_BYTES=2097152
# MAX_STRESS_ITERATIONS=2000
# MAX_GENERATED_TESTS=200
# MAX_JOB_DURATION_SEC=1800
# MAX_ACTIVE_RUNS_PER_PROBLEM=3

# ── Phase 5: Codeforces Polygon API ──
# Option A (simplest): put your own key/secret here. Never commit backend/.env.
POLYGON_API_KEY=
POLYGON_API_SECRET=
# Fixed to the official host; other hosts are rejected.
POLYGON_API_BASE_URL=https://polygon.codeforces.com/api
# Option B: save credentials from Settings → Polygon Integration (stored Fernet-encrypted).
# Generate a key with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
POLYGON_CREDENTIALS_KEY=
# POLYGON_STATEMENT_LANG=english
# POLYGON_TESTSET=tests
# POLYGON_TIMEOUT_SEC=60
# POLYGON_MIN_INTERVAL_SEC=0.25

# ── Phase 6: authentication, limits, operations ──
# Required in production (>= 32 random chars): python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
COOKIE_SECURE=false          # true in production (HTTPS)
REGISTRATION_OPEN=true       # false for private deployments (create users with python -m app.cli create-user)
# POLYGON_ENV_CREDENTIALS_EMAIL=   # in production, env Polygon credentials apply only to this user
# AI_TIMEOUT_SEC=120
# AI_MAX_OUTPUT_TOKENS=8192
# AI_MAX_CALLS_PER_USER_PER_DAY=200
# METRICS_TOKEN=
# LOG_JSON=false
# SANDBOX_RUNTIME=runsc      # gVisor, if installed
